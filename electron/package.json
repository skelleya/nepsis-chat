{
  "name": "nepsis-chat",
  "version": "0.1.3",
  "description": "Nepsis Chat - WebRTC voice chat",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && npm run build -- --mode desktop",
    "bump": "node scripts/bump-version.js",
    "package": "npm run package:win",
    "package:win": "npm run build:frontend && electron-builder --win",
    "package:mac": "npm run build:frontend && electron-builder --mac",
    "package:all": "npm run build:frontend && electron-builder --win --mac",
    "package:full": "npm run package:win && npm run copy-exe && npm run bump",
    "publish:github": "npm run build:frontend && electron-builder --win --mac -p always",
    "publish:github:win": "npm run build:frontend && electron-builder --win -p always",
    "publish:github:mac": "npm run build:frontend && electron-builder --mac -p always",
    "copy-exe": "node scripts/copy-exe.js",
    "publish-update": "node scripts/publish-update.js"
  },
  "author": "Nepsis",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.7.3"
  },
  "build": {
    "appId": "com.nepsis.chat",
    "productName": "Nepsis Chat",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico"
    ],
    "publish": {
      "provider": "github",
      "owner": "skelleya",
      "repo": "nepsis-chat",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NepsisChat-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "NepsisChat-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nepsis Chat needs the microphone for voice chat.",
        "NSCameraUsageDescription": "Nepsis Chat needs the camera for video in voice channels."
      }
    },
    "dmg": {
      "artifactName": "NepsisChat-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "webapp"
      }
    ]
  }
}
