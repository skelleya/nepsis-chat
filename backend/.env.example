PORT=3000
CORS_ORIGINS=*
SUPABASE_URL=https://qeopqyquskszzgprghiy.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Required — Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional — enables searchable GIF picker (Tenor API v2)
TENOR_API_KEY=
# GIF_IMPORT_MAX_BYTES=8388608

# Optional — custom TURN for P2P voice/calls (overrides free Open Relay fallback)
# Comma-separated URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
# Served to clients via GET /api/webrtc/ice
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Set TURN_FALLBACK=0 to disable the built-in Open Relay TURN when TURN_URLS is empty
# TURN_FALLBACK=1
